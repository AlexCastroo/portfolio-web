---
import Layout from '../layouts/Layout.astro';
import { useTranslations } from '../i18n/utils';

const lang = 'es' as const;
const t = useTranslations(lang);

const steps = [
  { n: '01', title: t('sv.process.s1t'), desc: t('sv.process.s1d') },
  { n: '02', title: t('sv.process.s2t'), desc: t('sv.process.s2d') },
  { n: '03', title: t('sv.process.s3t'), desc: t('sv.process.s3d') },
];
const projects = [
  {
    img: '',
    color: '#ff5b1f',
    title: t('sv.proj1.title'),
    desc: t('sv.proj1.desc'),
    tags: ['Laravel', 'Vue 3', 'MySQL', 'Docker'],
    url: 'https://areasoccer.app',
    wip: false,
    nda: false,
  },
  {
    img: '',
    color: '#3b82f6',
    title: t('sv.proj2.title'),
    desc: t('sv.proj2.desc'),
    tags: ['Laravel', 'Stripe', 'MySQL', 'Blade'],
    url: '',
    wip: false,
    nda: true,
  },
  {
    img: '',
    color: '#10b981',
    title: t('sv.proj3.title'),
    desc: t('sv.proj3.desc'),
    tags: ['Laravel', 'Vue 3', 'WebSockets', 'Docker'],
    url: '',
    wip: true,
    nda: false,
  },
];
const stats = [
  { n: parseInt(t('sv.proof.s1n')), suffix: '+', label: t('sv.proof.s1l') },
  { n: parseInt(t('sv.proof.s2n')), suffix: '',  label: t('sv.proof.s2l') },
  { n: parseInt(t('sv.proof.s3n')), suffix: '',  label: t('sv.proof.s3l') },
];

const waUrl   = 'https://wa.me/34674154366';
const mailUrl = 'mailto:castroecija.alejandro@gmail.com';

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Alex Castro",
  "jobTitle": "Desarrollador Fullstack Freelance",
  "url": "https://alexcastro.dev",
  "description": t('sv.meta.desc'),
  "sameAs": [
    "https://www.linkedin.com/in/alexcastroecija/",
    "https://github.com/AlexCastroo"
  ],
  "knowsAbout": ["Laravel", "PHP", "Desarrollo Web", "Tiendas Online", "Automatización IA", "E-commerce"],
  "makesOffer": [
    { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Página Web", "description": t('sv.svc1.desc') } },
    { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Tienda Online", "description": t('sv.svc2.desc') } },
    { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Automatización IA", "description": t('sv.svc3.desc') } },
    { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Desarrollo a Medida", "description": t('sv.svc4.desc') } }
  ]
});

const breadcrumbLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://alexcastro.dev" },
    { "@type": "ListItem", "position": 2, "name": "Servicios", "item": "https://alexcastro.dev/servicios" }
  ]
});
---

<Layout lang={lang} title={t('sv.meta.title')} description={t('sv.meta.desc')} hreflangEs="/servicios" hreflangEn="/en/services">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={jsonLd} />
    <script type="application/ld+json" set:html={breadcrumbLd} />
  </Fragment>
<main>

<!-- ══ NAV ══════════════════════════════════════════════════ -->
<header class="sn">
  <div class="sn-inner">
    <a href="/" class="sn-back mono small">{t('sv.nav.back')}</a>
    <a href="/" class="sn-brand mono">Alex Castro <span class="sn-muted">— dev</span></a>
    <div class="sn-right">
      <div class="lang-switch mono small">
        <a href="/servicios" class="lang-opt lang-active">ES</a>
        <a href="/en/services" class="lang-opt">EN</a>
      </div>
      <a href={waUrl} class="sn-cta">{t('sv.nav.cta')}</a>
    </div>
  </div>
</header>

<!-- ══ HERO ══════════════════════════════════════════════════ -->
<section class="sh" id="top">
  <div class="sh-wrap">
    <div class="sh-eyebrow mono small">{t('sv.hero.eyebrow')}</div>

    <h1 class="sh-title">
      <span class="sh-pre">{t('sv.hero.pre')}</span>
      <em class="sh-hl serif-it">{t('sv.hero.hl')}</em>
      <span class="sh-post">{t('sv.hero.post')}</span>
    </h1>

    <div class="sh-slide">
      <p class="sh-s1">{t('sv.hero.slide1')}</p>
      <p class="sh-s2">{t('sv.hero.slide2')}</p>
      <p class="sh-s3">{t('sv.hero.slide3')}</p>
      <p class="sh-s4 orange">{t('sv.hero.slide4')}</p>
    </div>

    <div class="sh-actions">
      <a href={waUrl} class="sh-cta-btn magnetic">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.6 6.3A7.7 7.7 0 0 0 4.7 16l-.9 3.3 3.4-.9a7.7 7.7 0 0 0 11.6-6.6 7.6 7.6 0 0 0-1.2-5.5zM12 18.5a6.4 6.4 0 0 1-3.3-.9l-.2-.1-2 .5.5-2-.1-.2A6.4 6.4 0 1 1 12 18.5zm3.5-4.8c-.2-.1-1.1-.6-1.3-.6-.2-.1-.3-.1-.4.1l-.6.7c-.1.1-.2.1-.4 0a5.2 5.2 0 0 1-2.6-2.2c-.2-.3.2-.3.5-1 0-.1 0-.2-.1-.3l-.6-1.4c-.2-.4-.3-.3-.4-.3h-.4c-.1 0-.3 0-.5.2-.2.2-.6.6-.6 1.5s.7 1.7.8 1.8c.1.1 1.3 2 3.1 2.8 1.1.5 1.5.5 2.1.4.3 0 1.1-.5 1.3-.9.1-.4.1-.8.1-.9-.1-.1-.2-.1-.4-.2z"/></svg>
        <span>{t('sv.hero.cta')}</span>
        <svg width="14" height="14" viewBox="0 0 14 14"><path d="M2 12 L12 2 M5 2 H12 V9" stroke="currentColor" stroke-width="1.5" fill="none"/></svg>
      </a>
    </div>

    <div class="sh-scroll mono small">
      <span>SCROLL</span>
      <svg width="10" height="36" viewBox="0 0 10 36"><path d="M5 0 V32 M1 28 L5 32 L9 28" stroke="currentColor" stroke-width="1" fill="none"/></svg>
    </div>
  </div>
  <div class="sh-glow"></div>
</section>

<!-- ══ PROBLEMS ══════════════════════════════════════════════ -->
<section class="sp">
  <div class="sp-inner">
    {[
      { stat: t('sv.p1.stat'), sub: t('sv.p1.sub') },
      { stat: t('sv.p2.stat'), sub: t('sv.p2.sub') },
      { stat: t('sv.p3.stat'), sub: t('sv.p3.sub') },
    ].map((p, i) => (
      <div class="sp-card reveal" style={`transition-delay: ${i * 0.12}s`}>
        <div class="sp-num mono small">{String(i + 1).padStart(2, '0')}</div>
        <p class="sp-stat">{p.stat}</p>
        <p class="sp-sub mono small">{p.sub}</p>
      </div>
    ))}
  </div>
</section>

<!-- ══ SERVICES ═══════════════════════════════════════════════ -->
<section class="ssv" id="servicios">
  <div class="ssv-wrap">
    <div class="ssv-head reveal">
      <span class="mono small muted">{t('sv.services.ref')}</span>
      <h2 class="ssv-title">{t('sv.services.title')}</h2>
      <p class="ssv-sub mono small muted">{t('sv.services.sub')}</p>
    </div>

    <!-- 3 standard services -->
    <div class="ssv-grid">
      {([
        {
          badge: t('sv.svc1.badge'), title: t('sv.svc1.title'),
          hook: t('sv.svc1.hook'), desc: t('sv.svc1.desc'),
          features: [t('sv.svc1.f1'), t('sv.svc1.f2'), t('sv.svc1.f3')],
          cta: t('sv.svc1.cta'),
        },
        {
          badge: t('sv.svc2.badge'), title: t('sv.svc2.title'),
          hook: t('sv.svc2.hook'), desc: t('sv.svc2.desc'),
          features: [t('sv.svc2.f1'), t('sv.svc2.f2'), t('sv.svc2.f3')],
          cta: t('sv.svc2.cta'),
        },
        {
          badge: t('sv.svc3.badge'), title: t('sv.svc3.title'),
          hook: t('sv.svc3.hook'), desc: t('sv.svc3.desc'),
          features: [t('sv.svc3.f1'), t('sv.svc3.f2'), t('sv.svc3.f3')],
          cta: t('sv.svc3.cta'),
        },
      ] as const).map((svc, i) => (
        <div class="ssv-card reveal" style={`transition-delay: ${i * 0.1}s`}>
          <div class="ssv-card-top">
            <span class="ssv-badge mono small">{svc.badge}</span>
          </div>
          <h3 class="ssv-card-title">{svc.title}</h3>
          <p class="ssv-card-hook orange">{svc.hook}</p>
          <p class="ssv-card-desc">{svc.desc}</p>
          <ul class="ssv-card-list">
            {svc.features.map(f => (
              <li><span class="ssv-check">✓</span><span>{f}</span></li>
            ))}
          </ul>
          <a href={waUrl} class="ssv-card-cta magnetic">
            <span>{svc.cta}</span>
            <svg width="14" height="14" viewBox="0 0 14 14"><path d="M2 12 L12 2 M5 2 H12 V9" stroke="currentColor" stroke-width="1.5" fill="none"/></svg>
          </a>
        </div>
      ))}
    </div>

    <!-- Featured: Desarrollo a medida -->
    <div class="ssv-ft reveal d2">
      <div class="ssv-ft-left">
        <span class="ssv-ft-eyebrow mono small orange">{t('sv.svc4.eyebrow')}</span>
        <span class="ssv-badge mono small">{t('sv.svc4.badge')}</span>
        <h3 class="ssv-ft-title display-tight">
          <span>{t('sv.svc4.title')}</span>
          <em class="serif-it orange">{t('sv.svc4.title2')}</em>
          <span>{t('sv.svc4.title3')}</span>
        </h3>
      </div>
      <div class="ssv-ft-right">
        <p class="ssv-ft-hook orange">{t('sv.svc4.hook')}</p>
        <p class="ssv-ft-desc">{t('sv.svc4.desc')}</p>
        <ul class="ssv-card-list ssv-ft-list">
          {[t('sv.svc4.f1'), t('sv.svc4.f2'), t('sv.svc4.f3'), t('sv.svc4.f4')].map(f => (
            <li><span class="ssv-check">✓</span><span>{f}</span></li>
          ))}
        </ul>
        <a href={waUrl} class="ssv-ft-cta magnetic">
          <span>{t('sv.svc4.cta')}</span>
          <svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 13 L13 3 M6 3 H13 V10" stroke="currentColor" stroke-width="1.6" fill="none"/></svg>
        </a>
      </div>
    </div>
  </div>
</section>

<!-- ══ PROOF ══════════════════════════════════════════════════ -->
<section class="spf">
  <div class="spf-wrap">
    <div class="mono small muted spf-ref reveal">{t('sv.proof.ref')}</div>
    <div class="spf-grid">
      {stats.map((s, i) => (
        <div class="spf-stat reveal" style={`transition-delay: ${i * 0.1}s`}>
          <div class="spf-num display" data-target={s.n} data-suffix={s.suffix}>0{s.suffix}</div>
          <div class="mono small muted spf-lbl">{s.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ══ PORTFOLIO ══════════════════════════════════════════════ -->
<section class="spj">
  <div class="spj-wrap">
    <div class="spj-head reveal">
      <span class="mono small muted">{t('sv.portfolio.ref')}</span>
      <h2 class="spj-title">{t('sv.portfolio.title')}</h2>
      <p class="spj-sub mono small muted">{t('sv.portfolio.sub')}</p>
    </div>
    <div class="spj-grid">
      {projects.map((p, i) => (
        <div class="spj-card reveal" style={`transition-delay: ${i * 0.1}s`}>
          <div class="spj-img" style={`--pj-color: ${p.color}`}>
            {p.img
              ? <img src={p.img} alt={p.title} loading="lazy" />
              : <div class="spj-placeholder">
                  <div class="spj-ph-dots">
                    <span class="spj-dot"></span>
                    <span class="spj-dot"></span>
                    <span class="spj-dot"></span>
                  </div>
                  <div class="spj-ph-bar b1"></div>
                  <div class="spj-ph-bar b2"></div>
                  <div class="spj-ph-bar b3"></div>
                  <div class="spj-ph-mock"></div>
                </div>
            }
            {p.wip && <span class="spj-badge-wip mono">{t('sv.portfolio.wip')}</span>}
          </div>
          <div class="spj-body">
            <div class="spj-tags">
              {p.tags.map(tag => <span class="spj-tag mono">{tag}</span>)}
            </div>
            <h3 class="spj-card-title">{p.title}</h3>
            <p class="spj-card-desc">{p.desc}</p>
            <div class="spj-footer">
              {!p.wip && p.url
                ? <a href={p.url} target="_blank" rel="noopener" class="spj-link">
                    <span>{t('sv.portfolio.viewSite')}</span>
                    <svg width="13" height="13" viewBox="0 0 14 14"><path d="M2 12 L12 2 M5 2 H12 V9" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="square"/></svg>
                  </a>
                : p.nda
                  ? <span class="spj-nda mono">— {t('sv.portfolio.nda')}</span>
                  : null
              }
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ══ PROCESS ════════════════════════════════════════════════ -->
<section class="spr" id="proceso">
  <div class="spr-wrap">
    <div class="spr-head reveal">
      <div class="mono small muted">{t('sv.process.ref')}</div>
      <h2 class="spr-title">{t('sv.process.title')}</h2>
    </div>
    <div class="spr-steps">
      {steps.map((s, i) => (
        <div class="spr-step reveal" style={`transition-delay: ${i * 0.15}s`}>
          <div class="spr-step-left">
            <div class="spr-node"><span class="mono spr-num">{s.n}</span></div>
            {i < steps.length - 1 && <div class="spr-line"></div>}
          </div>
          <div class="spr-step-content">
            <h3 class="spr-step-title">{s.title}</h3>
            <p class="spr-step-desc">{s.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ══ FINAL CTA ══════════════════════════════════════════════ -->
<section class="sc" id="contacto">
  <div class="sc-wrap">
    <div class="sc-eyebrow mono small reveal">{t('sv.cta.eyebrow')}</div>
    <h2 class="sc-title reveal d1">{t('sv.cta.title')}</h2>
    <div class="sc-slide reveal d2">
      <p class="sc-s1">{t('sv.cta.slide1')}</p>
      <p class="sc-s2 orange">{t('sv.cta.slide2')}</p>
    </div>
    <p class="sc-sub mono small reveal d2">{t('sv.cta.sub')}</p>
    <div class="sc-actions reveal d3">
      <a href={waUrl} class="sc-btn sc-btn-primary magnetic">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.6 6.3A7.7 7.7 0 0 0 4.7 16l-.9 3.3 3.4-.9a7.7 7.7 0 0 0 11.6-6.6 7.6 7.6 0 0 0-1.2-5.5zM12 18.5a6.4 6.4 0 0 1-3.3-.9l-.2-.1-2 .5.5-2-.1-.2A6.4 6.4 0 1 1 12 18.5zm3.5-4.8c-.2-.1-1.1-.6-1.3-.6-.2-.1-.3-.1-.4.1l-.6.7c-.1.1-.2.1-.4 0a5.2 5.2 0 0 1-2.6-2.2c-.2-.3.2-.3.5-1 0-.1 0-.2-.1-.3l-.6-1.4c-.2-.4-.3-.3-.4-.3h-.4c-.1 0-.3 0-.5.2-.2.2-.6.6-.6 1.5s.7 1.7.8 1.8c.1.1 1.3 2 3.1 2.8 1.1.5 1.5.5 2.1.4.3 0 1.1-.5 1.3-.9.1-.4.1-.8.1-.9-.1-.1-.2-.1-.4-.2z"/></svg>
        <span>{t('sv.cta.wa')}</span>
      </a>
      <a href={mailUrl} class="sc-btn sc-btn-ghost magnetic">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M2 7l10 7 10-7"/></svg>
        <span>{t('sv.cta.email')}</span>
      </a>
    </div>
  </div>
  <div class="sc-glow"></div>
</section>

<footer class="sf mono small">
  <span>{t('sv.footer')}</span>
  <a href="/" class="sf-back">{t('sv.footer.back')} →</a>
</footer>
</main>
</Layout>

<style>
  /* ─── NAV ─── */
  .sn { position: fixed; top: 0; left: 0; right: 0; z-index: 50; backdrop-filter: blur(14px); background: rgba(10,10,10,0.8); border-bottom: 1px solid var(--line); }
  .sn-inner { max-width: 1400px; margin: 0 auto; padding: 16px 24px; display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .sn-back { color: var(--cream-faint); transition: color .2s; font-size: 11px; letter-spacing: .08em; text-transform: uppercase; }
  .sn-back:hover { color: var(--cream); }
  .sn-brand { font-size: 12px; letter-spacing: .08em; }
  .sn-muted { color: var(--cream-faint); }
  .sn-right { display: flex; align-items: center; gap: 12px; }
  .sn-cta { padding: 8px 16px; border: 1px solid var(--accent); border-radius: 999px; font-size: 12px; letter-spacing: .08em; text-transform: uppercase; color: var(--accent); transition: all .25s; }
  .sn-cta:hover { background: var(--accent); color: var(--ink); }

  /* ─── HERO ─── */
  .sh { position: relative; min-height: 100vh; display: flex; align-items: center; padding: 120px 0 80px; overflow: hidden; }
  .sh-wrap { max-width: 1400px; margin: 0 auto; padding: 0 24px; position: relative; z-index: 2; width: 100%; }
  .sh-eyebrow { color: var(--cream-faint); margin-bottom: 32px; font-size: 11px; letter-spacing: .12em; opacity: 0; transform: translateY(16px); animation: fadeUp .7s .2s both; }
  .sh-title { margin: 0 0 48px; display: flex; flex-direction: column; line-height: 0.85; }
  .sh-pre  { font-family: 'Archivo'; font-weight: 900; letter-spacing: -0.05em; font-size: clamp(48px, 9vw, 130px); color: var(--cream-dim); opacity: 0; animation: lineUp .9s .35s cubic-bezier(.2,.7,.2,1) both; }
  .sh-hl   { font-family: 'Instrument Serif'; font-style: italic; font-size: clamp(72px, 14vw, 200px); color: var(--accent); opacity: 0; animation: lineUp 1s .5s cubic-bezier(.2,.7,.2,1) both; text-shadow: 0 0 100px rgba(255,91,31,0.45), 0 0 200px rgba(255,91,31,0.2); }
  .sh-post { font-family: 'Archivo'; font-weight: 900; letter-spacing: -0.05em; font-size: clamp(48px, 9vw, 130px); color: var(--cream); opacity: 0; animation: lineUp .9s .65s cubic-bezier(.2,.7,.2,1) both; }

  /* The Slide sub-copy */
  .sh-slide { margin-bottom: 48px; opacity: 0; animation: fadeUp .8s .85s both; }
  .sh-slide p { margin: 0; line-height: 1.15; }
  .sh-s1 { font-size: clamp(20px, 2.2vw, 28px); color: var(--cream-dim); font-weight: 400; }
  .sh-s2 { font-size: clamp(20px, 2.2vw, 28px); color: var(--cream); font-weight: 600; margin-bottom: 12px; }
  .sh-s3 { font-size: clamp(14px, 1.4vw, 18px); color: var(--cream-faint); }
  .sh-s4 { font-size: clamp(14px, 1.4vw, 18px); font-weight: 600; }

  .sh-actions { opacity: 0; animation: fadeUp .8s 1s both; }
  .sh-cta-btn { display: inline-flex; align-items: center; gap: 12px; padding: 18px 32px; border-radius: 999px; background: var(--cream); color: var(--ink); font-family: 'Archivo'; font-weight: 700; font-size: 15px; letter-spacing: .04em; text-transform: uppercase; transition: background .3s, color .3s; }
  .sh-cta-btn:hover { background: var(--accent); color: var(--ink); }
  .sh-scroll { position: absolute; bottom: 40px; left: 24px; display: flex; align-items: center; gap: 10px; color: var(--cream-faint); opacity: 0; animation: fadeUp .8s 1.3s both; }
  /* Dot grid behind hero */
  .sh::before {
    content: '';
    position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background-image: radial-gradient(circle, rgba(255,255,255,0.055) 1px, transparent 1px);
    background-size: 38px 38px;
    mask-image: radial-gradient(ellipse 85% 85% at 50% 50%, black 20%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 85% 85% at 50% 50%, black 20%, transparent 100%);
  }
  .sh-glow { position: absolute; inset: 0; z-index: 1; pointer-events: none; background: radial-gradient(ellipse 55% 65% at 82% 38%, rgba(255,91,31,0.14) 0%, transparent 65%), radial-gradient(ellipse 30% 40% at 10% 70%, rgba(255,91,31,0.06) 0%, transparent 65%); }

  /* ─── PROBLEMS ─── */
  .sp { padding: 80px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); background: var(--ink-2); }
  .sp-inner { max-width: 1400px; margin: 0 auto; padding: 0 24px; display: grid; grid-template-columns: 1fr; }
  @media (min-width: 900px) { .sp-inner { grid-template-columns: repeat(3, 1fr); } }
  .sp-card { padding: 48px 40px; border-bottom: 1px solid var(--line); position: relative; overflow: hidden; }
  /* Decorative background number per card */
  .sp-card::before {
    position: absolute; top: -10px; right: 20px;
    font-family: 'Archivo'; font-weight: 900; font-size: 130px; line-height: 1;
    color: rgba(255,255,255,0.04); pointer-events: none; user-select: none; letter-spacing: -0.05em;
  }
  .sp-card:nth-child(1)::before { content: "01"; }
