---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);

const esUrl = '/';
const enUrl = '/en/';
const servicesUrl = lang === 'es' ? '/servicios' : '/en/services';
---

<header class="nav" id="site-nav">
  <div class="wrap nav-row">
    <a href="#top" class="nav-brand">
      <span class="brand-dot"></span>
      <span class="mono">Alex Castro <span class="muted">— dev</span></span>
    </a>
    <nav class="nav-links">
      <a href="#about">{t('nav.about')}</a>
      <a href="#stack">{t('nav.stack')}</a>
      <a href="#work">{t('nav.work')}</a>
      <a href="#contact">{t('nav.contact')}</a>
      <a href={servicesUrl} class="nav-services-link mono small">{t('nav.services')} ↗</a>
    </nav>
    <div class="nav-right">
      <div class="lang-switch mono small">
        <a href={esUrl} class:list={['lang-opt', { 'lang-active': lang === 'es' }]}>ES</a>
        <a href={enUrl} class:list={['lang-opt', { 'lang-active': lang === 'en' }]}>EN</a>
      </div>
      <a href="#contact" class="nav-cta">
        <span>{t('nav.cta')}</span>
        <svg width="14" height="14" viewBox="0 0 14 14"><path d="M2 12 L12 2 M5 2 H12 V9" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="square"/></svg>
      </a>
      <button class="nav-burger" id="nav-burger" aria-label={t('nav.menuLabel')}>
        <span id="burger-top"></span>
        <span id="burger-mid"></span>
        <span id="burger-bot"></span>
      </button>
    </div>
  </div>
  <div class="nav-mobile" id="nav-mobile" style="display:none">
    <a href="#about" class="nav-mobile-link">{t('nav.about')}</a>
    <a href="#stack" class="nav-mobile-link">{t('nav.stack')}</a>
    <a href="#work" class="nav-mobile-link">{t('nav.work')}</a>
    <a href="#contact" class="nav-mobile-link">{t('nav.contact')}</a>
    <a href={servicesUrl} class="nav-mobile-link nav-services-link">{t('nav.services')} ↗</a>
    <div class="lang-switch mono small">
      <a href={esUrl} class:list={['lang-opt', { 'lang-active': lang === 'es' }]}>ES</a>
      <a href={enUrl} class:list={['lang-opt', { 'lang-active': lang === 'en' }]}>EN</a>
    </div>
  </div>
</header>

<style>
  .nav-right {
    display: flex; align-items: center; gap: 12px;
  }
  .nav-services-link {
    color: var(--accent) !important;
    border: 1px solid rgba(255,91,31,0.3);
    padding: 3px 10px;
    border-radius: 4px;
    font-size: 10px !important;
    letter-spacing: 0.1em;
    transition: background .2s ease, border-color .2s ease;
  }
  .nav-services-link:hover {
    background: rgba(255,91,31,0.1);
    border-color: var(--accent);
  }
  .nav-services-link::after { display: none !important; }
</style>

<script>
  const burger = document.getElementById('nav-burger')!;
  const mobile = document.getElementById('nav-mobile')!;
  const top = document.getElementById('burger-top')!;
  const mid = document.getElementById('burger-mid')!;
  const bot = document.getElementById('burger-bot')!;
  let open = false;

  burger.addEventListener('click', () => {
    open = !open;
    mobile.style.display = open ? 'flex' : 'none';
    top.style.transform = open ? 'translateY(6.5px) rotate(45deg)' : '';
    mid.style.opacity = open ? '0' : '1';
    bot.style.transform = open ? 'translateY(-6.5px) rotate(-45deg)' : '';
  });

  document.querySelectorAll('.nav-mobile-link').forEach(link => {
    link.addEventListener('click', () => {
      open = false;
      mobile.style.display = 'none';
      top.style.transform = '';
      mid.style.opacity = '1';
      bot.style.transform = '';
    });
  });
</script>
