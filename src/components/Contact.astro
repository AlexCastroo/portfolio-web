---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="contact" id="contact">
  <div class="wrap">
    <div class="section-head reveal">
      <div class="mono small muted">{t('contact.sectionRef')}</div>
      <div class="mono small muted">{t('contact.sectionLabel')}</div>
    </div>
    <hr class="rule" />

    <div class="contact-inner">
      <div class="contact-big reveal">
        <h2 class="display-tight contact-h">
          <span>{t('contact.h1')}</span>
          <span>{t('contact.h2')}</span>
          <span class="serif-it orange">{t('contact.h3')}</span>
        </h2>
      </div>
      <p class="contact-sub mono small reveal d1">
        {t('contact.sub')}
      </p>

      <div class="contact-actions reveal d2">
        <a href="https://wa.me/34674154366" class="btn-primary big" data-hover>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.6 6.3A7.7 7.7 0 0 0 4.7 16l-.9 3.3 3.4-.9a7.7 7.7 0 0 0 11.6-6.6 7.6 7.6 0 0 0-1.2-5.5zM12 18.5a6.4 6.4 0 0 1-3.3-.9l-.2-.1-2 .5.5-2-.1-.2A6.4 6.4 0 1 1 12 18.5zm3.5-4.8c-.2-.1-1.1-.6-1.3-.6-.2-.1-.3-.1-.4.1l-.6.7c-.1.1-.2.1-.4 0a5.2 5.2 0 0 1-2.6-2.2c-.2-.3.2-.3.5-1 0-.1 0-.2-.1-.3l-.6-1.4c-.2-.4-.3-.3-.4-.3h-.4c-.1 0-.3 0-.5.2-.2.2-.6.6-.6 1.5s.7 1.7.8 1.8c.1.1 1.3 2 3.1 2.8 1.1.5 1.5.5 2.1.4.3 0 1.1-.5 1.3-.9.1-.4.1-.8.1-.9-.1-.1-.2-.1-.4-.2z"/></svg>
          <span>{t('contact.whatsapp')}</span>
          <svg width="14" height="14" viewBox="0 0 14 14"><path d="M2 12 L12 2 M5 2 H12 V9" stroke="currentColor" stroke-width="1.5" fill="none"/></svg>
        </a>
        <a href="mailto:castroecija.alejandro@gmail.com" class="btn-ghost big" data-hover>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M2 7l10 7 10-7"/></svg>
          <span>{t('contact.email')}</span>
          <svg width="14" height="14" viewBox="0 0 14 14"><path d="M2 12 L12 2 M5 2 H12 V9" stroke="currentColor" stroke-width="1.5" fill="none"/></svg>
        </a>
        <a href="/FullStackDeveloper_AlexCastro.pdf" download class="btn-ghost big" data-hover>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          <span>{t('contact.cv')}</span>
          <svg width="14" height="14" viewBox="0 0 14 14"><path d="M2 12 L12 2 M5 2 H12 V9" stroke="currentColor" stroke-width="1.5" fill="none"/></svg>
        </a>
      </div>

      <div class="social-links reveal d3">
        <a href="https://www.linkedin.com/in/alexcastroecija/" target="_blank" rel="noopener" class="social-badge" data-hover>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          <span>{t('contact.linkedin')}</span>
        </a>
        <a href="https://github.com/AlexCastroo" target="_blank" rel="noopener" class="social-badge" data-hover>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
          <span>{t('contact.github')}</span>
        </a>
        <a href="/FullStackDeveloper_AlexCastro.pdf" download class="social-badge" data-hover>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          <span>{t('contact.resume')}</span>
        </a>
      </div>
    </div>

    <footer class="footer">
      <div class="footer-row mono small">
        <span>© 2026 Alex Castro</span> <span>{t('contact.footer')}</span>
      </div>
      <div class="footer-mega display-tight">
        ALEX</br>CASTRO
      </div>
    </footer>
  </div>
</section>
