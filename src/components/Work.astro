---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);

const jobs = [
  { co: t('work.job1.co'), role: t('work.job1.role'), date: t('work.job1.date'), desc: t('work.job1.desc') },
  { co: t('work.job2.co'), role: t('work.job2.role'), date: t('work.job2.date'), desc: t('work.job2.desc') },
  { co: t('work.job3.co'), role: t('work.job3.role'), date: t('work.job3.date'), desc: t('work.job3.desc') },
  { co: t('work.job4.co'), role: t('work.job4.role'), date: t('work.job4.date'), desc: t('work.job4.desc') },
];
const tags = ["Laravel", "Vue 3", "MySQL", "Docker"];
---

<section class="work" id="work">
  <div class="wrap">
    <div class="section-head reveal">
      <div class="mono small muted">{t('work.sectionRef')}</div>
      <div class="mono small muted">{t('work.sectionLabel')}</div>
    </div>
    <hr class="rule" />

    <div class="featured">
      <div class="featured-meta reveal">
        <span class="mono small muted">{t('work.featured')}</span>
        <span class="mono small muted">— ⌥ FT</span>
      </div>

      <div class="featured-grid">
        <div class="featured-left">
          <h2 class="display-tight featured-title reveal">
            Area<span class="orange">Soccer</span>
          </h2>
          <p class="featured-desc reveal d1">{t('work.featuredDesc')}</p>
          <div class="tag-row reveal d2">
            {tags.map(tag => <span class="tag mono small">{tag}</span>)}
          </div>
          <a href="#" class="btn-ghost reveal d3" data-hover>
            <span>{t('work.seeProject')}</span>
            <svg width="16" height="16" viewBox="0 0 16 16"><path d="M2 8 H14 M10 4 L14 8 L10 12" stroke="currentColor" stroke-width="1.6" fill="none"/></svg>
          </a>
          <div class="featured-numbers reveal d4">
            <div><span class="display">100</span><span class="mono small muted">{t('work.users')}</span></div>
            <div><span class="display">98<small>%</small></span><span class="mono small muted">{t('work.uptime')}</span></div>
          </div>
        </div>

        <div class="featured-right reveal d2">
          <div class="device-laptop">
            <div class="device-frame">
              <div class="device-screen">
                <div class="mock-topbar">
                  <span class="mock-dot"></span><span class="mock-dot"></span><span class="mock-dot"></span>
                  <span class="mono small mock-url">areasoccer.app / dashboard</span>
                </div>
                <div class="mock-body">
                  <div class="mock-side">
                    <span>·· Liga</span>
                    <span>·· Equipos</span>
                    <span class="mock-active">·· Partidos</span>
                    <span>·· Jugadores</span>
                    <span>·· Stats</span>
                  </div>
                  <div class="mock-main">
                    <div class="mock-h">
                      <span class="display mock-big">17<small>:00</small></span>
                      <span class="mono small">JORNADA · 12</span>
                    </div>
                    <div class="mock-match">
                      <div class="mock-team">
                        <span class="mock-crest"></span>
                        <span>CD Atlético</span>
                      </div>
                      <div class="mock-score display">2 — 1</div>
                      <div class="mock-team">
                        <span class="mock-crest c2"></span>
                        <span>Real Norte</span>
                      </div>
                    </div>
                    <div class="mock-stats">
                      <div><span class="mono small muted">POSESIÓN</span><div class="bar"><div style="width:62%"></div></div></div>
                      <div><span class="mono small muted">TIROS</span><div class="bar"><div style="width:48%"></div></div></div>
                      <div><span class="mono small muted">PASES</span><div class="bar"><div style="width:78%"></div></div></div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <div class="device-base"></div>
          </div>
        </div>
      </div>
    </div>

    <hr class="rule" style="margin-top: 4rem" />

    <div class="xp">
      <div class="xp-head reveal">
        <h3 class="display xp-title">{t('work.experience')}</h3>
        <span class="mono small muted">{t('work.timeline')}</span>
      </div>
      <div class="timeline">
        {jobs.map((j, i) => (
          <div class="t-row reveal" style={`transition-delay: ${i * 0.08}s`}>
            <div class="t-left">
              <div class="t-node"><span></span></div>
              <div class="t-line"></div>
            </div>
            <div class="t-content">
              <div class="t-meta mono small muted">{j.date}</div>
              <div class="t-headline">
                <span class="t-co display">{j.co}</span>
                <span class="t-role">— {j.role}</span>
              </div>
              <p class="t-desc">{j.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
